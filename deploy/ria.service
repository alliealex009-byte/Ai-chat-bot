[Unit]
Description=RIA Telegram AI companion (bot + API)
After=network-online.target ollama.service docker.service
Wants=network-online.target ollama.service docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ria
Group=ria
WorkingDirectory=/opt/ria
ExecStart=/opt/ria/venv/bin/python -m app.main
Restart=always
RestartSec=5
# Allow in-flight replies to finish on stop/restart
TimeoutStopSec=45
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
# Keep RIA from starving Ollama
Nice=5
MemoryMax=1500M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/ria/logs /opt/ria/data

[Install]
WantedBy=multi-user.target
