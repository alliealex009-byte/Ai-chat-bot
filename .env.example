# =====================================================================
# RIA — VPS configuration  (copy to .env, then: chmod 600 .env)
#   cp .env.example .env && nano .env
# NEVER commit .env to GitHub (it is in .gitignore).
# scripts/install.sh creates .env for you and fills in generated secrets.
# =====================================================================

# ---- Telegram (REQUIRED) --------------------------------------------
# Get from @BotFather. Use ONE token with exactly ONE polling process (this VPS).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id(s) for /health (get from @userinfobot). Comma separated.
ADMIN_USER_IDS=
# Extra owners (numeric ids, comma separated). Everyone in ADMIN_USER_IDS is also an owner of the /owner panel.
# Access is by numeric id ONLY (usernames can change). Get ids from @userinfobot.
OWNER_USER_IDS=
OWNER_NAME=AAKASH
OWNER_USERNAME=Advik_prakashh

# ---- Ollama (local only; never expose port 11434) -------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_TEMPERATURE=0.8
AI_TOP_P=0.9
AI_MAX_TOKENS=60
# Used when the user asks for explanations/help (longer answers)
AI_MAX_TOKENS_LONG=500
AI_CONTEXT_LENGTH=2048
# CPU threads for inference (8 vCPU box: 8 is fine; try 6 if the OS feels starved)
AI_NUM_THREADS=8
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_RETRIES=1

# ---- Optional API fallback (OFF by default; local Gemma stays primary) ----
AI_MODE=local
ENABLE_API_FALLBACK=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_DAILY_REQUEST_LIMIT=200
OPENROUTER_DAILY_TOKEN_LIMIT=100000

# ---- MongoDB (RIA's OWN instance, localhost:27018 — not your sticker bot DB) ----
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_USER=ria_admin
# Strong password. install.sh generates one if left empty (hex, URL-safe).
# NOTE: Mongo only applies this on first creation of the data volume.
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB_NAME=ria_database
# Optional: full URI overrides the fields above (MONGO_URL also works as the name)
MONGO_URI=

# ---- Conversation & memory -----------------------------------------
HISTORY_MESSAGES=8
HISTORY_CHAR_BUDGET=3000
MAX_INPUT_CHARS=2000
CONVERSATION_RETENTION_DAYS=30
MAX_STORED_MESSAGES_PER_USER=200
MEMORY_ENABLED=true
MEMORY_EXTRACT_EVERY_N_MESSAGES=8
MAX_MEMORIES_PER_USER=50
MEMORIES_IN_PROMPT=8
DEFAULT_LANGUAGE=hinglish

# ---- Concurrency & rate limits (CPU inference is the bottleneck) ----
# Start with 2. Each running inference uses CPU threads; more is NOT faster on 8 vCPUs.
MAX_CONCURRENT_INFERENCE=2
MAX_QUEUE_SIZE=30
MAX_QUEUED_PER_USER=1
QUEUE_WAIT_TIMEOUT_SECONDS=150
USER_RATE_LIMIT_MESSAGES=8
USER_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT_MESSAGES=120
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60

# ---- HTTP API for the Hugging Face Space ----------------------------
API_ENABLED=true
# Bound to localhost; nginx/Caddy terminates HTTPS and proxies to it.
API_HOST=127.0.0.1
API_PORT=8000
# REQUIRED (>= 32 chars). Generate:  openssl rand -hex 32
# Put the SAME value in the HF Space secret RIA_API_TOKEN. install.sh generates one.
API_TOKEN=
API_RATE_LIMIT_PER_MINUTE=30
API_GLOBAL_RATE_LIMIT_PER_MINUTE=300
API_LINK_CODE_TTL_SECONDS=600
API_SESSION_TTL_DAYS=30
# Only needed if a browser calls the API directly (normally NOT: the HF backend calls it).
API_CORS_ORIGINS=

# ---- Optional Hugging Face inference replica (OFF by default) -------
# VPS never depends on it; it is only tried after local Ollama fails.
HF_REPLICA_ENABLED=false
HF_REPLICA_URL=
HF_REPLICA_TOKEN=
HF_REPLICA_TIMEOUT_SECONDS=60
HF_REPLICA_HEALTH_INTERVAL_SECONDS=60

# Max replies per group per minute (stops spam in groups)
GROUP_RATE_LIMIT_MESSAGES=12

# ---- Logging --------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
# Keep false: private chat text is not written to logs.
LOG_MESSAGE_CONTENT=false
