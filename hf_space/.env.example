# =====================================================================
# RIA — Hugging Face Space configuration
# On Hugging Face set these in:  Space -> Settings -> "Variables and secrets"
#   * SECRETS (hidden):   RIA_API_TOKEN, ADMIN_PASSWORD, SESSION_SECRET, REPLICA_TOKEN
#   * VARIABLES (public): RIA_API_URL, ENABLE_REPLICA, OLLAMA_MODEL
# Do NOT put real values in this file or in GitHub. For local testing copy to .env (git-ignored).
# =====================================================================

# URL of the VPS API behind HTTPS (variable). No trailing slash.
RIA_API_URL=https://ria-api.example.com

# SECRET. Must equal API_TOKEN in the VPS .env  (VPS: grep ^API_TOKEN= /opt/ria/.env)
RIA_API_TOKEN=

# SECRET. Password for /admin dashboard. Use a long random one:  openssl rand -base64 24
ADMIN_PASSWORD=

# SECRET. Signs admin cookies. Generate:  openssl rand -hex 32
SESSION_SECRET=

# ---- Optional inference replica (default OFF; VPS works without it) ----
ENABLE_REPLICA=false
# SECRET. Same value as HF_REPLICA_TOKEN in the VPS .env  (openssl rand -hex 32)
REPLICA_TOKEN=
OLLAMA_MODEL=gemma3:4b

# Local testing only (allows http cookies). Never set on Hugging Face.
# LOCAL_DEV=1
